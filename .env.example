# 서버 포트
PORT=3000
# 관리자 비밀번호 (반드시 변경)
ADMIN_PASSWORD=change-me-strong-password
# 관리자 로그인 토큰 서명용 비밀키 (아무 긴 무작위 문자열: openssl rand -hex 32)
SESSION_SECRET=
# SQLite 파일 위치 (클라우드에서는 영구 디스크 경로로)
DB_PATH=./data/reservations.db
# 리버스 프록시(Nginx, Render, Fly 등) 뒤에서 실행하면 1
TRUST_PROXY=
# 며칠 뒤까지 예약 가능한지
MAX_DAYS_AHEAD=180
# 처음 실행할 때만 쓰이는 초기값 (이후엔 관리자 화면에서 변경)
CHURCH_NAME=우리교회
CHURCH_SUBTITLE=CHURCH · SPACE BOOKING
DEFAULT_SPACES=본당,소예배실,교육관
